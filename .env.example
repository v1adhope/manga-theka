# Server bind address.
APP_ADDR=0.0.0.0:3000

# Postgres connection. The password is sensitive; do not commit a real value.
APP_DATABASE__USERNAME=postgres
APP_DATABASE__PASSWORD=postgres
APP_DATABASE__HOST=localhost
APP_DATABASE__PORT=5432
APP_DATABASE__DATABASE_NAME=manga_theka

# Standard postgres URL for tools that expect it (sqlx-cli)
DATABASE_URL="postgres://${APP_DATABASE__USERNAME}:${APP_DATABASE__PASSWORD}@${APP_DATABASE__HOST}:${APP_DATABASE__PORT}/${APP_DATABASE__DATABASE_NAME}"

# Object storage (RustFS, S3-compatible). The secret key is sensitive; do not
# commit a real value.
APP_OBJECT_STORAGE__ENDPOINT=http://localhost:9000
APP_OBJECT_STORAGE__REGION=us-east-1
APP_OBJECT_STORAGE__ACCESS_KEY=rustfsadmin
APP_OBJECT_STORAGE__SECRET_KEY=rustfsadmin
APP_OBJECT_STORAGE__COVERS_BUCKET=book-covers
APP_OBJECT_STORAGE__RELEASE_PAGES_BUCKET=release-pages

# Redis, the refresh-session store. The URL may embed credentials and is
# therefore sensitive; do not commit a real value.
APP_REDIS__URL=redis://localhost:6379

# JWT signing key material. Each class loads a PKCS#8 PEM private key and its
# SPKI PEM public key; generate them with `task keys-generate`. TTLs are in
# seconds: access 15 min, refresh 30 days.
APP_AUTH__JWT_ACCESS__PRIVATE_KEY=.keys/jwt_access_private.pem
APP_AUTH__JWT_ACCESS__PUBLIC_KEY=.keys/jwt_access_public.pem
APP_AUTH__JWT_ACCESS__TTL=900
APP_AUTH__JWT_REFRESH__PRIVATE_KEY=.keys/jwt_refresh_private.pem
APP_AUTH__JWT_REFRESH__PUBLIC_KEY=.keys/jwt_refresh_public.pem
APP_AUTH__JWT_REFRESH__TTL=2592000

# Pepper for keyed session-jti hashing. Sensitive; do not commit a real
# value.
APP_AUTH__PEPPER__KEY=dev-only-change-me

# Argon2id parameters (OWASP baseline: 19456 KiB memory, 2 iterations, 1 lane).
APP_AUTH__PASSWORD__M_COST=19456
APP_AUTH__PASSWORD__T_COST=2
APP_AUTH__PASSWORD__P_COST=1

# Tracing log level. Accepts tracing EnvFilter syntax: "info", "debug",
# "warn", or directive lists like "info,sqlx=warn".
APP_LOG_LEVEL=info
