# Server bind address.
APP_ADDR=0.0.0.0:3000

# Postgres connection. The password is sensitive; do not commit a real value.
APP_DATABASE__USERNAME=postgres
APP_DATABASE__PASSWORD=change_me
APP_DATABASE__HOST=localhost
APP_DATABASE__PORT=5432
APP_DATABASE__DATABASE_NAME=manga_theka

# Standard postgres URL for tools that expect it (sqlx-cli)
DATABASE_URL="postgres://${APP_DATABASE__USERNAME}:${APP_DATABASE__PASSWORD}@${APP_DATABASE__HOST}:${APP_DATABASE__PORT}/${APP_DATABASE__DATABASE_NAME}"

# Tracing log level. Accepts tracing EnvFilter syntax: "info", "debug",
# "warn", or directive lists like "info,sqlx=warn".
APP_LOG_LEVEL=info
